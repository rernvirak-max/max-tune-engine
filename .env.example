APP_NAME=MaxTune
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://max-tune-engine.test
APP_MODE=personal
# Modes: personal (register off) | invite (invite codes required) | public (open registration)
MAX_UPLOAD_KB=51200
DEFAULT_STORAGE_QUOTA_BYTES=5368709120
UPLOAD_RATE_LIMIT=20
# Add from YouTube link (see config/max-tune.php "youtube"); prod sets YTDLP_BINARY via nixpacks.toml
YTDLP_BINARY=yt-dlp
FFMPEG_BINARY=
YTDLP_JS_RUNTIMES=
YOUTUBE_IMPORT_QUEUE=imports

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=max_tune
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=media
QUEUE_CONNECTION=database
# YouTube imports use the "database-imports" connection (config/queue.php); keep this above
# YOUTUBE_JOB_TIMEOUT_SECONDS + 60 or a long import is handed to the worker twice
YOUTUBE_QUEUE_RETRY_AFTER=900

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@maxtune.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost:9100,127.0.0.1:9100,localhost:9101,127.0.0.1:9101
CORS_ALLOWED_ORIGINS=http://localhost:9100,http://127.0.0.1:9100,http://localhost:9101,http://127.0.0.1:9101,http://localhost:9000,http://127.0.0.1:9000
FRONTEND_URL=http://localhost:9100

JAMENDO_CLIENT_ID=

VITE_APP_NAME="${APP_NAME}"

